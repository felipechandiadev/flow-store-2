# Flow Store Backend Configuration
# Copy this file to .env and update values for your environment

# Application
NODE_ENV=development
PORT=3010
API_PREFIX=api

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=flow_user
DB_PASSWORD=flow_password
DB_DATABASE=flow-store
# En local, true = el esquema sigue las entidades (sin carpeta migrations)
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=60000

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=flow:
REDIS_TTL=3600
REDIS_CLUSTER_MODE=false

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# Logging
LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Metrics & Monitoring
METRICS_ENABLED=true
METRICS_PREFIX=flow_backend
HEALTH_CHECK_ENABLED=true

# Production Configuration (uncomment and update for production)
# NODE_ENV=production
# PORT=3000
# DB_USERNAME=flowstore_prod
# DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
# DB_DATABASE=flow_store_prod
# DB_MAX_CONNECTIONS=20
# JWT_SECRET=CHANGE_THIS_TO_A_VERY_STRONG_SECRET_KEY_32_CHARS_MIN
# JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_VERY_STRONG_SECRET_KEY_32_CHARS_MIN
# CORS_ORIGIN=https://yourdomain.com
# CORS_CREDENTIALS=true
# LOG_LEVEL=warn
# REDIS_PASSWORD=your-redis-password

# SSL/TLS Configuration (for HTTPS)
# SSL_ENABLED=true
# SSL_KEY_PATH=/path/to/ssl/private.key
# SSL_CERT_PATH=/path/to/ssl/certificate.crt

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DEST=uploads/

# Email Configuration (if using email features)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# External APIs
# EXTERNAL_API_KEY=your-external-api-key
# EXTERNAL_API_URL=https://api.external-service.com

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Monitoring & Alerting
# ALERT_EMAIL=admin@yourdomain.com
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# External APIs (Optional)
GOLD_API_URL=
GOLD_API_KEY=

# Email (Future use)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# File Upload
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=10485760

# ==================== MEDIA STORAGE CONFIGURATION ====================
# Storage strategy: 'cloudflare' or 'local'
STORAGE_STRATEGY=local

# CloudFlare R2 Configuration (if using CloudFlare)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Local Storage Configuration (if using local)
LOCAL_STORAGE_PATH=./public/uploads

# Multimedia limits
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
MEDIA_PUBLIC_BASE_PATH=/multimedia/files

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Business Rules
MAX_TRANSACTION_LINES=100
DEFAULT_CURRENCY=COP
TIMEZONE=America/Bogota

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_CORS=true
ENABLE_HEALTH_CHECK=true
ENABLE_METRICS=true
ENABLE_CACHE=true